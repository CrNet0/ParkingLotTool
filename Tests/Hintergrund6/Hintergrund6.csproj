<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <Abgleichquelle Condition="'$(Abgleichquelle)' == ''">../../Geometry/HintergrundAbgleich.cs</Abgleichquelle>
    <Kursquelle Condition="'$(Kursquelle)' == ''">../../Geometry/HintergrundKurspruefung.cs</Kursquelle>
    <Taktquelle Condition="'$(Taktquelle)' == ''">../../Geometry/HintergrundTakt.cs</Taktquelle>
    <Indexquelle Condition="'$(Indexquelle)' == ''">../../Geometry/HintergrundLageindex.cs</Indexquelle>
    <Herkunftquelle Condition="'$(Herkunftquelle)' == ''">../../Geometry/HintergrundDefinitionsherkunft.cs</Herkunftquelle>
    <Schreiberquelle Condition="'$(Schreiberquelle)' == ''">../../Tools/ParkingLotBauzettelSchreiber.cs</Schreiberquelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Geometry/*.cs" Exclude="../../Geometry/HintergrundAbgleich.cs;../../Geometry/HintergrundKurspruefung.cs;../../Geometry/HintergrundTakt.cs;../../Geometry/HintergrundLageindex.cs;../../Geometry/HintergrundDefinitionsherkunft.cs" Link="Geometry/%(Filename)%(Extension)" />
    <Compile Include="../../Geometry/Zellen/*.cs" Link="Geometry/Zellen/%(Filename)%(Extension)" />
    <Compile Include="$(Abgleichquelle);$(Kursquelle);$(Taktquelle);$(Indexquelle);$(Herkunftquelle);$(Schreiberquelle)" />
    <Compile Include="../../Tools/ParkingLotBuildReceipt.cs;../../Tools/ParkingLotBauzettelquelle.cs;../../Tools/ParkingLotBaukontext.cs;../../Tools/ParkingLotBaukontextLeser.cs" />
    <Reference Include="Unity.Mathematics"><HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
