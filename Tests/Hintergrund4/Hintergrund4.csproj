<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework>
    <Auftragsquelle Condition="'$(Auftragsquelle)' == ''">../../Geometry/HintergrundAuftragsregel.cs</Auftragsquelle>
    <Kursquelle Condition="'$(Kursquelle)' == ''">../../Geometry/HintergrundKurspruefung.cs</Kursquelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts/**/*.cs" />
    <Compile Include="$(Auftragsquelle)" Link="HintergrundAuftragsregel.cs" />
    <Compile Include="$(Kursquelle)" Link="HintergrundKurspruefung.cs" />
    <Reference Include="Unity.Mathematics"><HintPath>$(CSII_TOOLPATH)/UnityModsProject/Library/ScriptAssemblies/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
