<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(CSII_MANAGEDPATH)</ManagedPath>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_MANAGEDPATH', 'EnvironmentVariableTarget.User'))</ManagedPath>
    <Zulassungsquelle Condition="'$(Zulassungsquelle)' == ''">../../Geometry/ExklusivesBaubild.cs</Zulassungsquelle>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(Zulassungsquelle)" Link="ExklusivesBaubild.cs" />
    <Reference Include="Game"><HintPath>$(ManagedPath)/Game.dll</HintPath></Reference>
    <Reference Include="Unity.Entities"><HintPath>$(ManagedPath)/Unity.Entities.dll</HintPath></Reference>
    <Reference Include="Unity.Mathematics"><HintPath>$(ManagedPath)/Unity.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
